# Where the portal's API lives. A path ("/api") is relative to the site the
# portal is served from; a full URL ("https://sunhub.in/api") calls it directly.
VITE_API_BASE_URL=/api

# Development only: proxy VITE_API_BASE_URL to this backend so the browser
# sees one origin. Leave empty to call VITE_API_BASE_URL directly.
VITE_DEV_PROXY_TARGET=

# How the backend authenticates the browser:
#   bearer  - login returns a token; it is sent as "Authorization: Bearer <token>"
#   cookie  - login sets a session cookie; requests are sent with credentials
VITE_AUTH_MODE=bearer
